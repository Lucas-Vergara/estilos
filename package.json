{
  "name": "@lucas-vergara/estilos",
  "version": "0.9.0",
  "description": "Biblioteca de estilos de Lucas: tokens, acentos, clases base y componentes React para mis proyectos.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "repository": "github:Lucas-Vergara/estilos",
  "files": [
    "css",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graficos": {
      "types": "./dist/graficos.d.ts",
      "default": "./dist/graficos.js"
    },
    "./sitio": {
      "types": "./dist/sitio/index.d.ts",
      "default": "./dist/sitio/index.js"
    },
    "./3d": {
      "types": "./dist/3d/index.d.ts",
      "default": "./dist/3d/index.js"
    },
    "./tokens.css": "./css/tokens.css",
    "./base.css": "./css/base.css",
    "./tailwind.css": "./css/tailwind.css",
    "./acentos/*": "./css/acentos/*",
    "./lineas/*": "./css/lineas/*"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "version": "node scripts/huella.mjs && npm run build && git add -A dist css",
    "vitrina": "vite --config vitrina/vite.config.ts",
    "vitrina:build": "vite build --config vitrina/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=19",
    "recharts": ">=3",
    "three": ">=0.180"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "three": "^0.186.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
